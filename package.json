{
  "name": "terminal-bridge",
  "displayName": "SDO Terminal Bridge",
  "description": "Opens, renames, and closes VS Code terminal tabs via a local HTTP API",
  "version": "0.33.2",
  "scripts": {
    "test": "node test/run.js"
  },
  "publisher": "sdo",
  "repository": {
    "type": "git",
    "url": "https://github.com/solcarty/vscode-terminal-bridge"
  },
  "engines": { "vscode": "^1.70.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Terminal Bridge",
      "properties": {
        "terminalBridge.pipelineStateDir": {
          "type": "string",
          "default": ".sdo",
          "description": "Directory (relative to each workspace folder) that /api/status appends pipeline-state.json into."
        },
        "terminalBridge.agentId": {
          "type": "string",
          "default": "",
          "description": "Identity this window's main agent announces to the presence registry (/announce, /api/bridges). Falls back to the workspace name, then the first folder's name, when unset."
        },
        "terminalBridge.hostsCommand": {
          "type": "string",
          "default": "",
          "description": "A command that prints every host's terminals as one JSON document (see the README, \"All hosts view\"). When set, an All hosts view appears in the Terminal Bridge container and runs it every 30 s while the view is visible. Empty: no view."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalBridge",
          "title": "Terminal Bridge",
          "icon": "media/terminal-bridge.svg"
        }
      ]
    },
    "views": {
      "terminalBridge": [
        {
          "id": "terminalBridge.terminals",
          "name": "Terminals"
        },
        {
          "id": "terminalBridge.hosts",
          "name": "All hosts",
          "when": "config.terminalBridge.hostsCommand"
        }
      ]
    },
    "commands": [
      {
        "command": "terminalBridge.showTerminal",
        "title": "Show Terminal",
        "category": "Terminal Bridge"
      },
      {
        "command": "terminalBridge.openHostTerminal",
        "title": "Open Host Terminal",
        "category": "Terminal Bridge"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "terminalBridge.showTerminal",
          "when": "false"
        },
        {
          "command": "terminalBridge.openHostTerminal",
          "when": "false"
        }
      ]
    }
  }
}
